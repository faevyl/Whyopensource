function resolve(url, base) {
  if (!url || url.startsWith('data:') || url.startsWith('blob:') || url.startsWith('javascript:') || url.startsWith('about:') || url.startsWith('mailto:') || url.startsWith('tel:') || url.startsWith('ws:') || url.startsWith('wss:')) return null;
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith('//')) return 'https:' + url;
  try { return new URL(url, base).href; } catch { return null; }
}

function mergeU(arrs) {
  const t = arrs.reduce((a, b) => a + b.length, 0);
  const r = new Uint8Array(t);
  let o = 0;
  for (const a of arrs) { r.set(a, o); o += a.length; }
  return r;
}

// ── CSS Rewriting ──
function rewriteCSS(css, baseUrl, prefix) {
  let base;
  try {
    const u = new URL(baseUrl);
    let dir = u.pathname;
    if (dir.length > 1 && !dir.endsWith('/')) dir = dir.substring(0, dir.lastIndexOf('/') + 1);
    base = u.origin + dir;
  } catch { base = baseUrl.replace(/\/+$/, '') + '/'; }
  const enc = (u) => prefix + encodeURIComponent(b64e(resolve(u, base)));
  // Rewrite @import "..." and @import '...'
  css = css.replace(/@import\s+["']([^"']+)["']\s*[^;]*;/gi, (m, url) => {
    url = url.trim();
    if (url.startsWith('data:') || url.startsWith('blob:') || url.startsWith('http:') || url.startsWith('https:')) return m;
    const r = resolve(url, base);
    if (!r) return m;
    const after = m.slice(m.indexOf(url) + url.length).replace(/^["']\s*/, '');
    return '@import "' + enc(r) + '" ' + after;
  });
  // Rewrite @import url(...)
  css = css.replace(/@import\s+url\s*\(\s*["']?([^'")\s]+)["']?\s*\)\s*[^;]*;/gi, (m, url) => {
    url = url.trim();
    if (url.startsWith('data:') || url.startsWith('blob:') || url.startsWith('http:') || url.startsWith('https:')) return m;
    const r = resolve(url, base);
    if (!r) return m;
    const after = m.slice(m.indexOf(')') + 1);
    return '@import url("' + enc(r) + '")' + after;
  });
  // Rewrite url(...) references
  css = css.replace(/url\(\s*["']?([^'")\s]+)["']?\s*\)/gi, (m, url) => {
    url = url.trim();
    if (!url || url.startsWith('data:') || url.startsWith('blob:') || url.startsWith('#') || url.startsWith('http:') || url.startsWith('https:')) return m;
    const r = resolve(url, base);
    return r ? "url('" + enc(r) + "')" : m;
  });
  return css;
}
