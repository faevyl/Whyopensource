          targetUrl = 'https://www.youtube.com' + here.pathname + here.search + here.hash;
        }
      }catch(e){}
      var mapped = String(targetUrl).match(/\/up\/([a-z0-9.-]+\.youtube(?:-nocookie)?\.com)(\/[^?#]*)?(\?[^#]*)?/i);
      if(mapped) targetUrl = 'https://' + mapped[1] + (mapped[2] || '/') + (mapped[3] || '');
      var workerBase = activeWorker().replace(/\/+$/,'');
      // if it's still a proxied url, decode the __pot token back to the real url
      var apiQ = targetUrl.match(/[?&](?:ddg|gsearch|q)=([^&]+)/);
      if(apiQ && /fetch\.php/i.test(targetUrl) && targetUrl.indexOf('__pot=') < 0){
        try{ targetUrl = decodeURIComponent(apiQ[1].replace(/\+/g, ' ')); }catch(e){ targetUrl = apiQ[1]; }
      } else if(/fetch\.php/i.test(targetUrl) || targetUrl.indexOf('__pot=') > -1 || targetUrl.indexOf(workerBase) === 0 || targetUrl.indexOf('/?__pot=') === 0 || targetUrl.indexOf('/?url=') === 0){
        try{
          var m = targetUrl.match(/__pot=([^&]+)/);
          if(m && m[1]){
            var edm = targetUrl.match(/encode_depth=(\d+)/);
            var tok = m[1];
            try{ tok = decodeURIComponent(tok); }catch(e){}
            targetUrl = b64unsafe(tok);
            if(edm){
              var n = parseInt(edm[1], 10);
              if(n > 0 && n <= 20){
                for(var di = 0; di < n; di++){
                  try{ targetUrl = decodeURIComponent(targetUrl); }catch(err){ break; }
                }
              }
            }
          }
        }catch(x){}
      }
      var input = document.getElementById('urlInput');
      var current = (input && input.value) ? input.value : (tabs[activeTab] && tabs[activeTab].url) || '';
      if(input){
        input.value = targetUrl;
        // experimental: show the decoded target as an address-bar tooltip
        if(settings.experimental) input.title = 'decoded: ' + targetUrl;
      }
      if(tabs[activeTab]){
        tabs[activeTab].url = targetUrl;
        tabs[activeTab].title = targetUrl;
        updateTabs();
        saveTabs();
      }
      // pop the proxied video overlay when a youtube video page was opened.
      // kamtape links now pop out into their own window (interceptor _pop), so
      // the in-ui overlay would just double up — skip it for kamtape hosts.
      if(targetUrl.indexOf('kamtape.com') === -1) openYtVideo(targetUrl);
      if(targetUrl === current) return; // avoid duplicate history entries
      if(historyPosition < historyStack.length - 1) historyStack = historyStack.slice(0, historyPosition + 1);
      historyStack.push(targetUrl);
      historyPosition = historyStack.length - 1;
      updateNavButtons();
    }

    // Init frame message listener
    window.addEventListener('message', function(e){
      if(!e.data || typeof e.data !== 'object') return;
      if(handleWispFrameMessage(e)) return;
      if(e.data.type === 'proxy:error'){
        setStatus('error');
      } else if(e.data.type === 'why:nav' || e.data.type === 'why:hello' || e.data.type === 'why:pong'){
        // interceptor navigated the iframe (nav) or the page just loaded (hello)
        // or answered our ping (pong) — surface the real page url.
        surfaceIframeUrl(e.data.url);
      }
    });

    // Init
    initSettingsUI();
    if(settings.engine === 'wisp' || settings.engine === 'libcurl' || settings.engine === 'auto') initWisp();
    renderBookmarkBar();
    renderQuickLinks();
    updateTabs();
    updateNavButtons();
    applySettings();
    initWhyDesktop();

    var openJump = '';
    try{
      openJump = new URL(location.href).searchParams.get('open') || '';
      if(openJump){
        history.replaceState(null, '', location.pathname);
        setTimeout(function(){ whyNavigate(openJump); }, 0);
      }
    }catch(e){}
    if(!openJump && settings.labRestore && tabs[activeTab] && tabs[activeTab].url){
      restoreTab(activeTab);
    } else if(!openJump){
      var homeStart = document.getElementById('homePage');
      if(homeStart) homeStart.classList.remove('hidden');
      var frameStart = document.getElementById('proxyFrame');
      if(frameStart) frameStart.classList.remove('active');
    }
    var frame = document.getElementById('proxyFrame');
    if(frame){
      frame.addEventListener('load', function(){
        try{ bindProxyClicks(frame); }catch(e){}
        try{
          var href = '';
          try{ href = frame.contentWindow.location.href; }catch(err){ href = ''; }
          if(href && href.indexOf('/go?') !== -1){
            try{
              var jump = new URL(href);
              var inner = jump.searchParams.get('u');
              if(inner && jump.pathname === '/go'){ whyNavigate(inner); return; }
            }catch(err){}
          }
          if(href && href.indexOf('about:') !== 0) surfaceIframeUrl(href);
          else if(frame.src) surfaceIframeUrl(frame.src);
        }catch(e){}
      });
    }
    // ensure no overlay is open at startup
    var so = document.getElementById('settingsMask');
    if(so) so.classList.remove('open');
    var sp = document.getElementById('settingsPanel');
    if(sp) sp.classList.remove('open');
    var ao = document.getElementById('aboutOverlay');
    if(ao) ao.classList.remove('open');
    var mb = document.getElementById('musicBar');
    if(mb) mb.classList.remove('open');
    try{ if(settings.antiDetect !== false) whySpoofAutomation(true); }catch(e){}
    armAutoAboutBlank();
  });

  var saverState = { mode: '', stars: null, bodies: null, W: 0, H: 0 };
  function applyScreensaver(){
    var cv = document.getElementById('screenSaver');
    if(!cv) return;
    var mode = settings.screensaver || 'off';
    cv.style.display = mode === 'off' ? 'none' : 'block';
    document.documentElement.classList.toggle('saver-on', mode !== 'off');
    saverState.mode = mode;
    if(mode !== 'gravity') saverState.bodies = null;
    if(mode !== 'stars') saverState.stars = null;
  }
  function bootScreensaver(){
    var cv = document.getElementById('screenSaver');
    if(!cv) return;
    var ctx = cv.getContext('2d');
    var dpr = 1;
    function resize(){
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      saverState.W = window.innerWidth;
      saverState.H = window.innerHeight;
      cv.width = Math.max(1, Math.floor(saverState.W * dpr));
      cv.height = Math.max(1, Math.floor(saverState.H * dpr));
      cv.style.width = saverState.W + 'px';
      cv.style.height = saverState.H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      saverState.stars = null;
      saverState.bodies = null;
    }
    resize();
    window.addEventListener('resize', resize);
    var clock = 0;
    function speed(){
      if(settings.reduceMotion) return 0;
      if(settings.screenSpeed === 'slow') return 0.45;
      if(settings.screenSpeed === 'fast') return 1.7;
      return 1;
    }
    function drawAurora(t, W, H){
      ctx.fillStyle = '#070b14';
      ctx.fillRect(0, 0, W, H);
      for(var band = 0; band < 6; band++){
        ctx.beginPath();
        ctx.moveTo(0, H);
        for(var x = 0; x <= W; x += 10){
          var y = H * 0.28 + band * 46
            + Math.sin(x * 0.006 + t * 0.35 + band) * 46
            + Math.sin(x * 0.018 - t * 0.6 + band * 1.7) * 16;
          ctx.lineTo(x, y);
        }
        ctx.lineTo(W, H);
        ctx.closePath();
        ctx.fillStyle = 'hsla(' + (128 + band * 26) + ',85%,' + (56 + band * 3) + '%,' + (0.16 + band * 0.05) + ')';
        ctx.fill();
      }
    }
    function drawQuantum(t, W, H){
      ctx.fillStyle = '#060814';
      ctx.fillRect(0, 0, W, H);
      for(var k = 0; k < 7; k++){
        ctx.beginPath();
        for(var x = 0; x <= W; x += 3){
          var env = Math.sin(x * 0.004 + t * 0.25 + k);
          var y = H * 0.5 + (k - 3) * 42 + Math.sin(x * 0.02 + t * (0.8 + k * 0.05)) * (28 + k * 6) * (0.35 + Math.abs(env));
          if(x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = 'hsla(' + (188 + k * 22) + ',90%,68%,0.62)';
        ctx.lineWidth = 1.6;
        ctx.stroke();
      }
    }
    function drawGravity(t, W, H){
      if(!saverState.bodies){
        saverState.bodies = [];
        for(var i = 0; i < 90; i++){
          saverState.bodies.push({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.6, vy: (Math.random() - 0.5) * 0.6
          });
        }
      }
      var cx = W * 0.5 + Math.cos(t * 0.22) * W * 0.18;
      var cy = H * 0.5 + Math.sin(t * 0.17) * H * 0.14;
      ctx.fillStyle = 'rgba(5,6,12,0.28)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(244,244,245,0.85)';
      var pts = saverState.bodies;
      for(var p = 0; p < pts.length; p++){
        var b = pts[p];
        var dx = cx - b.x, dy = cy - b.y;
        var pull = 28 / (dx * dx + dy * dy + 9000);
        b.vx = (b.vx + dx * pull) * 0.992;
        b.vy = (b.vy + dy * pull) * 0.992;
        b.x += b.vx; b.y += b.vy;
        if(b.x < 0 || b.x > W) b.vx *= -1;
        if(b.y < 0 || b.y > H) b.vy *= -1;
        ctx.fillRect(b.x, b.y, 2, 2);
      }
      ctx.beginPath();
      ctx.arc(cx, cy, 5, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(125,211,252,0.9)';
      ctx.fill();
    }
    function drawStars(t, W, H){
      if(!saverState.stars){
        saverState.stars = [];
        for(var i = 0; i < 140; i++){
          saverState.stars.push({ x: Math.random() * W, y: Math.random() * H, z: Math.random() * 1 + 0.2, s: Math.random() * 1.6 + 0.4 });
        }
      }
      ctx.fillStyle = '#05060c';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = '#f4f4f5';
      var list = saverState.stars;
      for(var i = 0; i < list.length; i++){
        var st = list[i];
        st.y += st.z * 1.4;
        st.x += Math.sin(t + i) * 0.15;
        if(st.y > H){ st.y = 0; st.x = Math.random() * W; }
        ctx.globalAlpha = 0.35 + st.z * 0.55;
        ctx.fillRect(st.x, st.y, st.s, st.s);
      }
      ctx.globalAlpha = 1;
    }
    function drawPlasma(t, W, H){
      var step = 8;
      for(var y = 0; y < H; y += step){
        for(var x = 0; x < W; x += step){
          var v = Math.sin(x * 0.02 + t) + Math.sin(y * 0.03 + t * 0.7) + Math.sin((x + y) * 0.015 + t * 0.4);
          var hue = (v * 40 + 200 + t * 12) % 360;
          ctx.fillStyle = 'hsl(' + hue + ',70%,42%)';
          ctx.fillRect(x, y, step, step);
        }
      }
    }
    function drawRibbons(t, W, H){
      ctx.fillStyle = '#080a10';
      ctx.fillRect(0, 0, W, H);
      for(var r = 0; r < 4; r++){
        ctx.beginPath();
        var y0 = H * (0.22 + r * 0.16);
        ctx.moveTo(0, y0);
        for(var x = 0; x <= W; x += 12){
          var y = y0 + Math.sin(x * 0.01 + t * 0.5 + r) * 34 + Math.cos(x * 0.004 - t * 0.3) * 18;
          ctx.lineTo(x, y);
        }
        ctx.strokeStyle = 'hsla(' + (265 + r * 28) + ',75%,68%,0.55)';
        ctx.lineWidth = 10 - r;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }
    (function frame(ts){
      requestAnimationFrame(frame);
      var mode = saverState.mode;
      if(!mode || mode === 'off') return;
      var sp = speed();
      clock += sp ? (0.016 * sp) : 0;
      var W = saverState.W, H = saverState.H;
      if(mode === 'aurora') drawAurora(clock, W, H);
      else if(mode === 'quantum') drawQuantum(clock, W, H);
      else if(mode === 'gravity') drawGravity(clock, W, H);
      else if(mode === 'stars') drawStars(clock, W, H);
      else if(mode === 'plasma') drawPlasma(clock, W, H);
      else if(mode === 'ribbons') drawRibbons(clock, W, H);
    })(0);
  }
  bootScreensaver();

})();
</script>
