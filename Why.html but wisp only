  // ── settings ui ──
  // note: applies all settings to the ui. add your new setting handler here.
  // how to add a setting handler: add a new if/var block after the existing ones below.
  function paintMark(glyph, img, text, color, image){
    if(!glyph) return;
    if(image){
      glyph.hidden = true;
      if(img){ img.hidden = false; img.src = image; }
      return;
    }
    if(img){ img.hidden = true; img.removeAttribute('src'); }
    glyph.hidden = false;
    glyph.textContent = text || 'W';
    var chosen = String(color || '').toLowerCase();
    glyph.style.background = (chosen && chosen !== '#1a73e8' && chosen !== '#4285f4') ? color : '';
  }
  function paintWordmark(el, text){
    var colors = ['#4285F4', '#EA4335', '#FBBC05', '#4285F4', '#34A853', '#EA4335'];
    el.textContent = '';
    var n = 0;
    for(var i = 0; i < text.length; i++){
      var ch = text.charAt(i);
      if(ch === ' '){ el.appendChild(document.createTextNode(' ')); continue; }
      var letter = document.createElement('span');
      letter.className = 'g-letter';
      letter.style.color = colors[n % colors.length];
      letter.textContent = ch;
      el.appendChild(letter);
      n++;
    }
  }
  function applyMark(){
    var text = String(settings.markText || 'W').slice(0, 2);
    var color = settings.markColor || '#1a73e8';
    var image = settings.markImage || '';
    paintMark(document.getElementById('brandGlyph'), document.getElementById('brandImg'), text, color, image);
    paintMark(document.getElementById('homeGlyph'), document.getElementById('homeImg'), text, color, image);
