  // ── Tab Management ──
  function updateTabs(){
    var container = document.getElementById('tabContainer');
    if(!container) return;
    container.innerHTML = '';
    // pinned tabs first, then unpinned (stable order)
    var ordered = tabs.map(function(t, idx){ return { t: t, i: idx }; })
      .sort(function(a, b){ return (a.t.pinned ? 0 : 1) - (b.t.pinned ? 0 : 1) || a.i - b.i; });
    ordered.forEach(function(entry){
      var tab = entry.t, i = entry.i;
      var pill = document.createElement('button');
      pill.className = 'tab-pill' + (i === activeTab ? ' active' : '') + (tab.pinned ? ' pinned' : '');
      pill.dataset.tabIndex = String(i);
      pill.title = tab.title || 'New Tab';
      var label = tab.title || 'New Tab';
      if(settings.labSiteTitle && tab.url){
        try{ label = new URL(tab.url).hostname.replace(/^www\./, ''); }catch(e){}
