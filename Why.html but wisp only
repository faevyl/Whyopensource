      var input2 = document.getElementById('urlInput');
      if(input2) input2.value = 'local file';
      if(historyPosition < historyStack.length - 1) historyStack = historyStack.slice(0, historyPosition + 1);
      historyStack.push(url);
      historyPosition = historyStack.length - 1;
      updateNavButtons();
      setStatus('ready');
      return;
    }

    // Check blacklist
    var bl = (settings.blacklist || '').split('\n').map(function(s){ return s.trim().toLowerCase(); }).filter(Boolean);
    var domain = '';
    try{ domain = new URL(url).hostname.toLowerCase(); }catch(e){ domain = url.toLowerCase(); }
    for(var i=0; i<bl.length; i++){
      if(domain === bl[i] || domain.endsWith('.' + bl[i])){
        showBlockPage(bl[i]);
        return;
      }
    }

    var frame = document.getElementById('proxyFrame');
    var home = document.getElementById('homePage');
    var bp = document.getElementById('blockPage');
    var input = document.getElementById('urlInput');
    if(bp) bp.classList.remove('open');
    if(home) home.classList.add('hidden');
    if(frame) frame.classList.add('active');
    if(input) input.value = url;
    dispatchTransport(url);

    // History
    if(historyPosition < historyStack.length - 1) historyStack = historyStack.slice(0, historyPosition + 1);
    historyStack.push(url);
    historyPosition = historyStack.length - 1;
    updateNavButtons();

    tabs[activeTab].url = url;
    tabs[activeTab].title = url;
    updateTabs();

    setStatus('loading');
    var loadToken = navToken;
    setTimeout(function(){
      if(loadToken !== navToken) return;
      var label = document.getElementById('statusLabel');
      if(label && label.textContent === 'Loading') setStatus('idle');
    }, 20000);
    saveTabs();
  }

