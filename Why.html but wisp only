  // CSP-immune worker probe: an <img> load is governed by img-src (or default-src),
  // NOT connect-src, so it still works on hosts that block cross-origin fetch().
  // we probe the worker's 1x1 gif endpoint and read latency from the load time.
  function probeWorker(w, onOk, onFail){
    var base = w.replace(/\?url=.*$/,'').replace(/\/+$/,'');
    var start = Date.now();
    var img = new Image();
    var done = false;
    var timer = setTimeout(function(){
      if(done) return;
      done = true;
      img.onload = img.onerror = null;
      if(onFail) onFail();
    }, 8000);
    img.onload = function(){
      if(done) return;
      done = true;
      clearTimeout(timer);
      var ms = Date.now() - start;
      if(onOk) onOk(ms);
    };
    img.onerror = function(){
      if(done) return;
      done = true;
      clearTimeout(timer);
      if(onFail) onFail();
    };
    img.src = /fetch\.php/i.test(w)
      ? (base + (base.indexOf('?') >= 0 ? '&' : '?') + 'ping=gif&_=' + Date.now())
      : (base + '/__why/ping.gif?_=' + Date.now());
  }

  // track consecutive probe failures so a blocked ping (ad blocker / csp on the
  // host page) never flips us to the fallback worker — the ping is only an
  // indicator. we only switch when the fallback actually responds.
  var mainProbeFails = 0;
  function pingWorker(){
    var w = activeWorker();
    var main = settings.proxyUrl || defaultSettings.proxyUrl;
    probeWorker(w, function(ms){
      mainProbeFails = 0;
      // if the main worker just recovered, prefer it again
      if(mainWorkerDown && w === main) mainWorkerDown = false;
      var dot = document.getElementById('connDot');
      var msEl = document.getElementById('connMs');
      if(msEl) msEl.textContent = ms + 'ms';
      if(dot){
        if(ms < 300) dot.className = 'connection-dot good';
        else if(ms < 800) dot.className = 'connection-dot fair';
        else dot.className = 'connection-dot poor';
      }
    }, function(){
      mainProbeFails++;
      var dot = document.getElementById('connDot');
      var msEl = document.getElementById('connMs');
      // main probe failed — probe the fallback worker. only switch to it if the
      // fallback actually answers; if it's equally unreachable (ad blocker
      // blocking all cross-origin pings) we stay on the main worker, which is
      // still fine for actual iframe navigation.
      if(w === main && settings.proxyUrl2){
        probeWorker(settings.proxyUrl2, function(ms){
          // fallback answered but main didn't across a couple of pings — switch
          if(mainProbeFails >= 2) mainWorkerDown = true;
          if(msEl) msEl.textContent = ms + 'ms (fb)';
          if(dot) dot.className = ms < 800 ? 'connection-dot fair' : 'connection-dot poor';
        }, function(){
          // both unreachable — keep the main worker, indicator shows unknown
          if(msEl) msEl.textContent = 'N/A';
          if(dot) dot.className = 'connection-dot poor';
        });
      } else {
        if(msEl) msEl.textContent = 'N/A';
        if(dot) dot.className = 'connection-dot poor';
      }
    });
  }
