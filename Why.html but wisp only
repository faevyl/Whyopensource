  function animateOpenTab(index){
    if(motionReduced()) return;
    var pill = document.querySelector('.tab-pill[data-tab-index="' + index + '"]');
    if(!pill) return;
    var width = pill.getBoundingClientRect().width || 160;
    pill.classList.add('opening');
    pill.style.flex = '0 0 auto';
    pill.style.overflow = 'hidden';
    pill.style.width = '0px';
    pill.style.maxWidth = '0px';
    pill.style.opacity = '0';
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        pill.style.width = width + 'px';
        pill.style.maxWidth = width + 'px';
        pill.style.opacity = '1';
      });
    });
    setTimeout(function(){
      pill.classList.remove('opening');
      pill.style.width = '';
      pill.style.maxWidth = '';
      pill.style.opacity = '';
