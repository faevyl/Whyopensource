  function restoreTab(i){
    var tab = tabs[i];
    var home = document.getElementById('homePage');
    var frame = document.getElementById('proxyFrame');
    var bp = document.getElementById('blockPage');
    var input = document.getElementById('urlInput');
    if(bp) bp.classList.remove('open');
    if(tab.url){
      if(WHY_WISP_ONLY){
        dispatchTransport(tab.url);
        if(input) input.value = tab.url;
        var idxW = historyStack.indexOf(tab.url);
        if(idxW >= 0) historyPosition = idxW;
        setStatus('wisp');
        return;
      }
      if(home) home.classList.add('hidden');
      if(frame){
        frame.classList.add('active');
        frame.src = tab.savedSrc || browseUrl(tab.url);
      }
      if(input) input.value = tab.url;
      // Restore history position
      var idx = historyStack.indexOf(tab.url);
      if(idx >= 0) historyPosition = idx;
      setStatus('idle');
    } else {
      if(home) home.classList.remove('hidden');
      if(frame) frame.classList.remove('active');
      if(input) input.value = '';
      setStatus('idle');
