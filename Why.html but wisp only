  // ── Cookie Viewer ──
  // local memory cookie store: mirrors target-site cookies into localStorage
  // (key why_cookies_v1) on the proxy origin, keyed by the real target origin.
  // returns the parsed map, or {} when localStorage is unavailable.
  function whyLocalCookies(){
    try{
      var raw = localStorage.getItem('why_cookies_v1');
      if(!raw) return {};
      var p = JSON.parse(raw);
      return (p && typeof p === 'object') ? p : {};
    }catch(e){ return {}; }
  }

  // note: shows the local memory store (the real target origins) first, then
  // any page cookies on the proxy origin. deleting updates both document.cookie
  // and the local memory store.
  function renderCookies(){
    var el = document.getElementById('cookieList');
    if(!el) return;
    var store = whyLocalCookies();
    var origins = [];
    for(var o in store){ if(store[o] && store[o].length > 0) origins.push(o); }
    var html = '';
    if(origins.length === 0){
      html += '<div class="dl-empty">No cookies in local memory</div>';
    }
    origins.forEach(function(origin){
      html += '<div class="ci-origin">' + escapeHtml(origin) + '</div>';
      var list = store[origin] || [];
      list.forEach(function(c){
        if(!c || c.length < 2) return;
        html += '<div class="cookie-item"><span class="ci-name">' + escapeHtml(c[0]) + '</span><span class="ci-value">' + escapeHtml(c[1]) + '</span><button class="ci-del" title="Delete" onclick="whyDeleteCookie(\'' + escapeHtml(origin) + '\',\'' + escapeHtml(c[0]) + '\')">&times;</button></div>';
      });
    });
    // page cookies on this origin (proxy origin), excluding the _s marker
    var page = [];
    var all = document.cookie.split(';');
    for(var i = 0; i < all.length; i++){
      var c = all[i].trim();
      if(!c || c.indexOf('_s=') === 0) continue;
      page.push(c);
    }
    if(page.length > 0){
      html += '<div class="ci-origin">This page (proxy origin)</div>';
      page.forEach(function(c){
        var eq = c.indexOf('=');
        var name = eq > -1 ? c.slice(0, eq) : c;
        var value = eq > -1 ? c.slice(eq + 1) : '';
        html += '<div class="cookie-item"><span class="ci-name">' + escapeHtml(name) + '</span><span class="ci-value">' + escapeHtml(value) + '</span><button class="ci-del" title="Delete" onclick="whyDeleteCookie(\'\',\'' + escapeHtml(name) + '\')">&times;</button></div>';
      });
    }
    el.innerHTML = html;
  }

  window.whyDeleteCookie = function(origin, name){
    if(!name){ name = origin; origin = ''; } // legacy single-arg call
    // expire the cookie from this page's jar
    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
    // remove it from the local memory store too
    var store = whyLocalCookies();
    if(origin && store[origin]){
      store[origin] = store[origin].filter(function(c){ return !c || c[0] !== name; });
      if(store[origin].length === 0) delete store[origin];
      try{ localStorage.setItem('why_cookies_v1', JSON.stringify(store)); }catch(e){}
    }
    renderCookies();
    whyToast('Cookie deleted');
  };

  window.whyClearAllCookies = function(){
    var cookies = document.cookie.split(';').filter(Boolean);
    cookies.forEach(function(c){
      var name = c.trim().split('=')[0];
      document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
    });
    try{ localStorage.removeItem('why_cookies_v1'); }catch(e){}
    renderCookies();
    whyToast('All cookies cleared');
  };

  // refresh the viewer when the proxy iframe writes to the local memory store
  window.addEventListener('storage', function(e){
    if(e.key !== 'why_cookies_v1' && e.key !== null) return;
    var sp = document.getElementById('settingsPanel');
    if(sp && sp.classList.contains('open')) renderCookies();
