  // ── typing sounds + kamtape music player ──
  // typing: opera-gx style mechanical clicks via web audio (no files).
  // music: play kamtape get_video in the page. that file is a real mp4 from
  // the user's browser — the file plays directly (a PHP host would only get the challenge).
  // hits Cloudflare's challenge HTML, so <video> has nothing to play).
  function initMusicAndTyping(){
    var audioCtx = null;
    var SILENT_WAV = 'data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA';
    function ensureAudio(){
      try{
        var AC = window.AudioContext || window.webkitAudioContext;
        if(!AC) return;
        if(!audioCtx) audioCtx = new AC();
        var st = audioCtx.state;
        if(st === 'suspended' || st === 'interrupted'){
          var r = audioCtx.resume();
          if(r && r.catch) r.catch(function(){});
        }
        if(audioCtx && !audioCtx._bufUnlock){
          try{
            var buf = audioCtx.createBuffer(1, 1, 22050);
            var src = audioCtx.createBufferSource();
            src.buffer = buf;
            src.connect(audioCtx.destination);
            src.start(0);
            audioCtx._bufUnlock = true;
          }catch(e2){}
        }
      }catch(e){}
      try{
        var u = document.getElementById('audioUnlock');
        if(u && !u._unlocked){
          u.muted = true;
          try{ u.removeAttribute('crossorigin'); }catch(e4){}
          u.src = SILENT_WAV;
          var p = u.play();
          if(p && p.then) p.then(function(){ try{ u.pause(); }catch(e5){} u.muted = false; u._unlocked = true; }).catch(function(){});
          else { u.muted = false; u._unlocked = true; }
        }
      }catch(e3){}
    }
    function playClick(){
      if(!audioCtx || audioCtx.state !== 'running') return;
      try{
        var t = audioCtx.currentTime;
        var o = audioCtx.createOscillator(), g = audioCtx.createGain();
        o.type='square'; o.frequency.value = 1200 + Math.random()*400;
        g.gain.setValueAtTime(0.05,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.045);
        o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t+0.05);
        var o2 = audioCtx.createOscillator(), g2 = audioCtx.createGain();
        o2.type='triangle'; o2.frequency.value=220;
        g2.gain.setValueAtTime(0.04,t); g2.gain.exponentialRampToValueAtTime(0.001,t+0.06);
        o2.connect(g2); g2.connect(audioCtx.destination); o2.start(t); o2.stop(t+0.06);
      }catch(e){}
    }
    function clickSound(){
      if(settings.typingSounds === false) return;
      ensureAudio(); if(!audioCtx) return;
      if(audioCtx.state === 'running') playClick();
      else {
        var r = audioCtx.resume();
        if(r && r.then) r.then(playClick).catch(function(){});
      }
    }
    function warmup(){ ensureAudio(); }
    ['pointerdown','mousedown','touchstart','touchend','click','keydown'].forEach(function(ev){
      window.addEventListener(ev, warmup, true);
      document.addEventListener(ev, warmup, true);
    });
    document.addEventListener('visibilitychange', function(){ if(!document.hidden) ensureAudio(); });
    window.addEventListener('pageshow', warmup);
    document.addEventListener('keydown', function(e){
      var tg = e.target;
      if(tg && (tg.tagName==='INPUT' || tg.tagName==='TEXTAREA' || tg.isContentEditable)){
        if(e.ctrlKey || e.metaKey || e.altKey) return;
        if(e.key && e.key.length === 1) clickSound();
      }
    }, true);

    var mBar = document.getElementById('musicBar');
    var mVideo = document.getElementById('musicVideo');
    var mAudio = document.getElementById('musicAudio');
    var mFrame = document.getElementById('musicFrame');
    var mTitle = document.getElementById('musicTitle');
    var mUrl = document.getElementById('musicUrl');
    var mPlayBtn = document.getElementById('musicPlayBtn');
    var queue = [], qIdx = -1, musicGen = 0;
    var musicActive = mVideo, musicMode = 'media', musicLastSrc = '';
    function hideMedia(el){
      if(!el) return;
      el.setAttribute('playsinline','');
      el.setAttribute('webkit-playsinline','');
      el.preload = 'auto';
      try{ el.removeAttribute('crossorigin'); }catch(e){}
      try{ el.referrerPolicy = 'no-referrer-when-downgrade'; }catch(e2){}
    }
    hideMedia(mVideo); hideMedia(mAudio);
    function musicPauseAll(){
      try{ if(mVideo) mVideo.pause(); }catch(e){}
      try{ if(mAudio) mAudio.pause(); }catch(e){}
      if(mFrame){ try{ mFrame.removeAttribute('src'); }catch(e){ try{ mFrame.src='about:blank'; }catch(e2){} } }
    }
    function musicSetPlaying(on){ if(mPlayBtn) mPlayBtn.textContent = on ? '\u275A\u275A' : '\u25B6'; }
    function musicIframe(src, title){
      musicMode = 'iframe'; musicLastSrc = src;
      if(!mFrame){
        mFrame = document.createElement('iframe');
        mFrame.id = 'musicFrame';
        document.body.appendChild(mFrame);
      }
      mFrame.setAttribute('allow','autoplay; encrypted-media');
      try{ mFrame.referrerPolicy = 'no-referrer-when-downgrade'; }catch(e){}
      mFrame.src = src;
      if(mTitle) mTitle.textContent = title || 'playing';
      musicSetPlaying(true);
    }
    function musicPlayEl(el, src, title, fallback){
      if(!el){ if(fallback) fallback(); return; }
      musicActive = el; musicMode = 'media'; musicLastSrc = src;
      hideMedia(el);
      var settled = false;
      function ok(){
        if(settled) return;
        settled = true;
        if(mTitle) mTitle.textContent = title || 'playing';
        musicSetPlaying(true);
      }
      function fail(){
        if(settled) return;
        settled = true;
        if(fallback) fallback();
      }
      el.onerror = fail;
      el.onplaying = ok;
      el.src = src;
      try{ el.load(); }catch(e){}
      var p;
      try{ p = el.play(); }catch(err){ fail(); return; }
      if(p && p.then) p.then(ok).catch(fail);
      else setTimeout(function(){ if(!settled && (el.error || el.readyState === 0)) fail(); }, 5000);
    }
    function musicLoadId(vid, label){
      ensureAudio();
      vid = kamTapeId(vid);
      if(!vid){
        if(mTitle) mTitle.textContent = 'need a video id';
        return;
      }
      var title = label || vid;
      var srcWebm = kamTapeFile(vid, true);
      var srcPlain = kamTapeFile(vid, false);
      var watchPage = 'https://www.kamtape.com/watch?v=' + encodeURIComponent(vid);
      var gen = ++musicGen;
      if(mTitle) mTitle.textContent = 'loading…';
      musicPauseAll();
      function still(){ return gen === musicGen; }
      function tryWatch(){
        if(!still()) return;
        musicIframe(watchPage, title);
        if(mTitle) mTitle.textContent = title || vid;
      }
      function tryPlain(){
        if(!still()) return;
        musicPlayEl(mVideo || mAudio, srcPlain, title, function(){ if(still()) tryWatch(); });
      }
      function tryAudio(){
        if(!still()) return;
        if(!mAudio){ tryPlain(); return; }
        musicPlayEl(mAudio, srcWebm, title, function(){ if(still()) tryPlain(); });
      }
      if(!mVideo){ tryAudio(); return; }
      musicPlayEl(mVideo, srcWebm, title, function(){ if(still()) tryAudio(); });
    }
    function musicPlayNow(vid){
      vid = kamTapeId(vid);
      queue.push(vid); qIdx = queue.length - 1; musicLoadId(vid, vid);
    }
    document.getElementById('musicBtn').onclick = function(){ if(mBar) mBar.classList.add('open'); };
    document.getElementById('musicCloseBtn').onclick = function(){ if(mBar) mBar.classList.remove('open'); };
    document.getElementById('musicLoadBtn').onclick = function(){
      ensureAudio();
      var v = mUrl.value.trim(); if(v) musicPlayNow(v);
    };
    mUrl.addEventListener('keydown', function(e){ if(e.key==='Enter') document.getElementById('musicLoadBtn').click(); });
    mPlayBtn.onclick = function(){
      ensureAudio();
      if(musicMode === 'iframe'){
        if(mFrame && mFrame.getAttribute('src') && mFrame.getAttribute('src') !== 'about:blank'){
          musicLastSrc = mFrame.src;
          try{ mFrame.removeAttribute('src'); }catch(e){ mFrame.src = 'about:blank'; }
          musicSetPlaying(false);
        } else if(musicLastSrc){
          musicIframe(musicLastSrc, mTitle ? mTitle.textContent : '');
        }
        return;
      }
      var el = musicActive || mVideo;
      if(!el){ if(musicLastSrc) musicIframe(musicLastSrc, mTitle ? mTitle.textContent : ''); return; }
      if(el.paused){
        var p = el.play();
        if(p && p.catch) p.catch(function(){ if(mTitle) mTitle.textContent = 'blocked — tap play again'; });
        musicSetPlaying(true);
      } else { el.pause(); musicSetPlaying(false); }
    };
    document.getElementById('musicPrevBtn').onclick = function(){ ensureAudio(); if(qIdx>0){ qIdx--; musicLoadId(queue[qIdx], queue[qIdx]); } };
    document.getElementById('musicNextBtn').onclick = function(){ ensureAudio(); if(qIdx<queue.length-1){ qIdx++; musicLoadId(queue[qIdx], queue[qIdx]); } };
    function bindMediaUi(el){
      if(!el) return;
      el.addEventListener('play', function(){ musicSetPlaying(true); });
      el.addEventListener('pause', function(){ musicSetPlaying(false); });
      el.addEventListener('ended', function(){ document.getElementById('musicNextBtn').click(); });
    }
    bindMediaUi(mVideo);
    bindMediaUi(mAudio);
  }

