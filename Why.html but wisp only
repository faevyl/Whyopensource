  function switchTab(i){
    if(i === activeTab) return;
    // Save current tab state
    var frame = document.getElementById('proxyFrame');
    if(frame && frame.src && frame.src !== 'about:blank'){
      tabs[activeTab].savedSrc = frame.src;
    }
    activeTab = i;
    updateTabs();
