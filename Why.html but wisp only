  // ── Build Proxy URL ──
  function buildToProxy(enc){
    var w = activeWorker();
    var b = w.replace(/\/+$/, '');
    if(b.includes('?url=')) b = b.replace(/\?url=.*$/, '') + '?__pot=' + enc;
    else if(b.includes('__pot=')) b = b.replace(/__pot=[^&]*/, '__pot=' + enc);
    else b += (b.includes('?') ? '&' : '?') + '__pot=' + enc;
    if(settings.darkReader) b += '&dark=1';
    if(settings.forceDevice === 'mobile') b += '&mode=force_mobile';
    else if(settings.forceDevice === 'pc') b += '&mode=force_pc';
    if(settings.blockAds) b += '&block_ads=1';
    if(settings.stripImages) b += '&strip_images=1';
    if(settings.readableMode) b += '&readable=1';
    if(settings.fetchOverhaul) b += '&overhaul=1';
    if(settings.cacheBust) b += '&_cb=' + Date.now();
    if(settings.customCSS) b += '&css=' + encodeURIComponent(b64safe(settings.customCSS));
    b += settings.antiDetect ? '&anti_detect=1' : '&anti_detect=0';
    b += '&nav=1';
    if(settings.experimental) b += '&experimental=1';
    if(settings.uiStyle === 'retro') b += '&retro=1';
    if(settings.theme) b += '&theme=' + encodeURIComponent(settings.theme);
    return b;
  }
  function buildProxyUrl(rawUrl){
    try{
      var e = whyEngine();
      var base = String(activeWorker() || '').replace(/\?.*$/, '').replace(/\/+$/, '');
      var tail = '';
      if(settings.darkReader) tail += '&dark=1';
      if(settings.forceDevice === 'mobile') tail += '&mode=force_mobile';
      else if(settings.forceDevice === 'pc') tail += '&mode=force_pc';
      if(settings.blockAds) tail += '&block_ads=1';
      if(settings.stripImages) tail += '&strip_images=1';
      if(settings.readableMode) tail += '&readable=1';
      if(settings.fetchOverhaul) tail += '&overhaul=1';
      tail += settings.antiDetect ? '&anti_detect=1' : '&anti_detect=0';
      tail += '&nav=1';
      if(e === 'legacy') return base + '?url=' + encodeURIComponent(rawUrl) + tail;
      if(e === 'wasm' || e === 'both'){
        var token = encodeURIComponent(b64wasm(rawUrl));
        if(e === 'both') return base + '?url=' + encodeURIComponent(rawUrl) + '&__pot=' + token + tail;
        return base + '?__pot=' + token + tail;
      }
      var mode = settings.encodeMode || 'base64';
      if(mode === 'deepEncode'){
        var enc2 = rawUrl;
        var depth = parseInt(settings.encodeDepth, 10) || 4;
        if(depth < 1) depth = 1;
        if(depth > 20) depth = 20;
        for(var i=0;i<depth;i++) enc2 = encodeURIComponent(enc2);
        return buildToProxy(b64safe(enc2)) + '&encode_depth=' + depth;
      }
      var enc;
      if(mode === 'plain') enc = encodeURIComponent(rawUrl);
      else if(mode === 'double64') enc = encodeURIComponent(b64safe(b64safe(rawUrl)));
      else enc = encodeURIComponent(b64safe(rawUrl));
      return buildToProxy(enc);
    }catch(e){ return rawUrl; }
  }
