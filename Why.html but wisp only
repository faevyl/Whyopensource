  function closeTab(i){
    if(tabs.length <= 1) return;
    if(tabs[i] && tabs[i].pinned) return; // pinned tabs can't be closed from the ×
    if(settings.labConfirmClose && tabs[i] && tabs[i].url && !confirm('close this tab?')) return;
    var pill = document.querySelector('.tab-pill[data-tab-index="' + i + '"]');
    var finish = function(){
      tabs.splice(i, 1);
      if(i < activeTab) activeTab--;
      else if(activeTab >= tabs.length) activeTab = tabs.length - 1;
      updateTabs();
      restoreTab(activeTab);
      saveTabs();
    };
    if(!pill || motionReduced()){ finish(); return; }
    var width = pill.getBoundingClientRect().width;
    pill.style.flex = '0 0 auto';
    pill.style.width = width + 'px';
    pill.style.maxWidth = width + 'px';
    pill.style.overflow = 'hidden';
    pill.classList.add('closing');
    requestAnimationFrame(function(){
      pill.style.width = '0px';
      pill.style.maxWidth = '0px';
      pill.style.marginLeft = '0px';
      pill.style.marginRight = '0px';
      pill.style.paddingLeft = '0px';
      pill.style.paddingRight = '0px';
      pill.style.opacity = '0';
    });
    var done = false;
    function end(){
      if(done) return;
      done = true;
      finish();
    }
    pill.addEventListener('transitionend', function(ev){ if(ev.propertyName === 'width') end(); });
    setTimeout(end, 320);
  }

